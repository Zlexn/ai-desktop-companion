# Stage 1 local configuration template

APP_NAME=AI Desktop Companion
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/app.db

# fake | anthropic | deepseek
LLM_PROVIDER=fake
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
FAKE_PROVIDER_MODE=ok
RECENT_CONTEXT_MESSAGES=12
# Gate C1 deterministic context budgets. These values grant no remote disclosure,
# memory write, summary processing, or summary injection consent.
# Persona and the current user message are protected and are never silently truncated.
# Memory type minima are soft; every optional layer can be removed to zero before send.
CHAT_CONTEXT_MAX_CHARACTERS=24000
CHAT_CURRENT_USER_MAX_CHARACTERS=8000
PERSONA_MAX_CHARACTERS=8000
CHAT_DYNAMIC_CONTEXT_MAX_CHARACTERS=8000
CHAT_EMOTION_CONTEXT_MAX_CHARACTERS=500
MEMORY_CONTEXT_USER_FACT_MAX_ITEMS=2
MEMORY_CONTEXT_USER_FACT_MAX_CHARACTERS=1200
MEMORY_CONTEXT_PREFERENCE_MAX_ITEMS=2
MEMORY_CONTEXT_PREFERENCE_MAX_CHARACTERS=1200
MEMORY_CONTEXT_LONG_TERM_GOAL_MAX_ITEMS=2
MEMORY_CONTEXT_LONG_TERM_GOAL_MAX_CHARACTERS=1200
MEMORY_CONTEXT_IMPORTANT_EVENT_MAX_ITEMS=1
MEMORY_CONTEXT_IMPORTANT_EVENT_MAX_CHARACTERS=800
MEMORY_CONTEXT_RELATIONSHIP_EVENT_MAX_ITEMS=1
MEMORY_CONTEXT_RELATIONSHIP_EVENT_MAX_CHARACTERS=800
MEMORY_CONTEXT_OTHER_MAX_ITEMS=1
MEMORY_CONTEXT_OTHER_MAX_CHARACTERS=600

# Stage 2A Fake TTS. This generates a deterministic test tone, not natural speech.
TTS_PROVIDER=fake
TTS_FAKE_MODE=ok
TTS_MAX_TEXT_CHARS=1000
TTS_DEFAULT_VOICE=fake-default
TTS_DEFAULT_SPEED=1.0

# Stage 2B Fake ASR foundation. This returns deterministic text and does not recognize real speech.
ASR_PROVIDER=fake
ASR_MAX_UPLOAD_BYTES=10485760
ASR_MAX_DURATION_MS=30000
ASR_MIN_DURATION_MS=300
ASR_DEFAULT_LANGUAGE=zh
FAKE_ASR_MODE=ok
FAKE_ASR_TEXT=这是 Fake ASR 测试转写。
FAKE_ASR_DETECTED_LANGUAGE=zh

# Optional Stage 2B-5 real local ASR. Keep ASR_PROVIDER=fake for default tests.
# To enable locally, install backend ASR extras and point the model path to an existing local snapshot.
# Example initial candidate from 2B-4: medium / cuda / float16 / beam=1 / zh.
# ASR_PROVIDER=faster-whisper
# ASR_FASTER_WHISPER_MODEL_PATH=C:\\Users\\<you>\\.cache\\huggingface\\hub\\models--Systran--faster-whisper-medium\\snapshots\\08e178d48790749d25932bbc082711ddcfdfbc4f
ASR_FASTER_WHISPER_MODEL_NAME=medium
ASR_FASTER_WHISPER_MODEL_REVISION=08e178d48790749d25932bbc082711ddcfdfbc4f
ASR_FASTER_WHISPER_DEVICE=cuda
ASR_FASTER_WHISPER_COMPUTE_TYPE=float16
ASR_FASTER_WHISPER_BEAM_SIZE=1
ASR_FASTER_WHISPER_TIMEOUT_SECONDS=30
# Optional Stage 2G-2 real FasterWhisper streaming feasibility. Disabled by default.
# This repeatedly decodes cumulative audio windows and is not final production-grade streaming ASR.
ASR_FASTER_WHISPER_STREAMING_ENABLED=false
ASR_FASTER_WHISPER_STREAMING_WINDOW_MS=3000
ASR_FASTER_WHISPER_STREAMING_STEP_MS=1000
ASR_FASTER_WHISPER_STREAMING_MIN_PARTIAL_CHARS=1
ASR_FASTER_WHISPER_STREAMING_MAX_PARTIALS=8

# DeepSeek Provider is optional. Leave DEEPSEEK_API_KEY empty unless using LLM_PROVIDER=deepseek locally.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING_ENABLED=false
DEEPSEEK_MAX_TOKENS=256
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_RETRIES=0

# Stage 3 long-term memory. Retrieval defaults to deterministic local relevance.
MEMORY_CONTEXT_ENABLED=true
MEMORY_CONTEXT_LIMIT=8
MEMORY_RETRIEVAL_MODE=relevance
MEMORY_RETRIEVAL_FALLBACK_LIMIT=3
MEMORY_CANDIDATES_ENABLED=true
MEMORY_CANDIDATE_PROVIDER=heuristic

# Stage 3F memory embedding retrieval is opt-in.
# Set MEMORY_RETRIEVAL_MODE=embedding and MEMORY_EMBEDDING_ENABLED=true to use embedding retrieval.
# The fake provider is deterministic and intended for local tests/smoke only.
MEMORY_EMBEDDING_ENABLED=false
MEMORY_EMBEDDING_PROVIDER=fake
MEMORY_EMBEDDING_MODEL=fake-memory-embedding-v1
MEMORY_EMBEDDING_MIN_SCORE=0.35

# Gate B automatic-memory deployment mode. auto_active still requires a separate,
# persisted local write grant; this environment value alone grants no write authority.
MEMORY_AUTOMATION_MODE=candidate_confirmation
# Extraction routing is independent from mode and from persisted remote consent.
# none = explicit skipped_no_extractor, local = conservative local rules,
# fake = deterministic development provider, remote = configured cloud provider.
MEMORY_EXTRACTOR_ROUTE=none
MEMORY_EXTRACTOR_PROVIDER=anthropic
# Empty inherits LLM_MODEL.
MEMORY_EXTRACTOR_MODEL=
MEMORY_EXTRACTOR_MAX_TOKENS=512
MEMORY_EXTRACTOR_TIMEOUT_SECONDS=15
# Gate A has no provider request idempotency key, so retries remain disabled.
MEMORY_EXTRACTOR_MAX_RETRIES=0
MEMORY_EXTRACTOR_MAX_PROPOSALS=3
MEMORY_EXTRACTOR_MAX_PROPOSAL_CHARACTERS=200
MEMORY_EXTRACTOR_MAX_TOTAL_CHARACTERS=600
# Local SQLite semantic retries rerun policy from a fresh snapshot; they never resend a Provider request.
MEMORY_COMMIT_SEMANTIC_RETRIES=2
# Path only. The 32-byte local HMAC key is created at runtime and never belongs in .env or Git.
MEMORY_SOURCE_REFERENCE_KEY_PATH=backend/data/memory-source-reference-v1.key
# IMPORTANT: environment configuration is neither remote-extraction nor automatic-write consent.
# /api/memories/extraction/consent manages only remote extraction disclosure.
# /api/memories/automation/write-consent manages the separate persisted local write grant.

# Gate C2 session summary deployment configuration. fake is deterministic and local.
# IMPORTANT: these values do not grant remote processing or chat injection consent.
SESSION_SUMMARY_ENABLED=true
SESSION_SUMMARY_PROVIDER=fake
# Legacy Stage 3 trigger retained until the durable turn-job migration replaces its callers.
SESSION_SUMMARY_TRIGGER_MESSAGE_COUNT=12
SESSION_SUMMARY_TRIGGER_TURN_COUNT=6
SESSION_SUMMARY_MAX_INPUT_TURNS=12
SESSION_SUMMARY_MAX_INPUT_MESSAGES=24
SESSION_SUMMARY_MAX_INPUT_CHARACTERS=12000
# Used only when SESSION_SUMMARY_PROVIDER=llm and exact processing consent is valid.
SESSION_SUMMARY_LLM_PROVIDER=deepseek
SESSION_SUMMARY_LLM_MODEL=deepseek-v4-flash
SESSION_SUMMARY_LLM_MAX_TOKENS=512
SESSION_SUMMARY_LLM_TIMEOUT_SECONDS=15
SESSION_SUMMARY_LLM_MAX_RETRIES=0
SESSION_SUMMARY_MAX_OUTPUT_CHARACTERS=2000
SUMMARY_INJECTION_MAX_FRAGMENTS=2
SUMMARY_INJECTION_MAX_FRAGMENT_CHARACTERS=1000
SUMMARY_INJECTION_MAX_TOTAL_CHARACTERS=1600
SUMMARY_INJECTION_MIN_LEXICAL_RELEVANCE=0.15
SUMMARY_REBUILD_MIN_SAFE_TURNS=1
SUMMARY_JOB_MAX_ATTEMPTS=3
SUMMARY_JOB_RECOVERY_STALE_SECONDS=300

# Gate C3 relationship processing is deterministic and local-only. These bounded
# operational values grant no memory write, relationship authority, remote processing,
# or chat injection consent and cannot expand the reviewed source/subject allowlist.
RELATIONSHIP_CONTEXT_MAX_CHARACTERS=600
RELATIONSHIP_RECONCILE_MAX_ATTEMPTS=3
RELATIONSHIP_RECOVERY_STALE_SECONDS=300

# Stage 4C optional remote LLM emotion analysis. Disabled means zero analysis calls.
# Enabling deployment configuration is not consent: the user must still grant persistent consent in the UI.
# anthropic | deepseek; the selected provider requires its existing API key above/below.
EMOTION_ANALYSIS_ENABLED=false
EMOTION_ANALYSIS_PROVIDER=deepseek
EMOTION_ANALYSIS_MODEL=deepseek-v4-flash
EMOTION_ANALYSIS_MAX_TOKENS=384
EMOTION_ANALYSIS_TIMEOUT_SECONDS=15
EMOTION_ANALYSIS_MAX_RETRIES=0
EMOTION_ANALYSIS_RECENT_MESSAGES=6
EMOTION_ANALYSIS_MEMORY_LIMIT=3
EMOTION_ANALYSIS_MAX_ITEM_CHARACTERS=2000
EMOTION_ANALYSIS_MAX_TOTAL_CHARACTERS=8000

# Vite development proxy only. Do not put API keys or secrets in VITE_* variables.
BACKEND_PROXY_TARGET=http://127.0.0.1:8000

# Only required when LLM_PROVIDER=anthropic.
# Never put a real API key in source control.
ANTHROPIC_API_KEY=
