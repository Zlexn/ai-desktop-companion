# Stage 1 local configuration template

APP_NAME=AI Desktop Companion
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/app.db

# fake | anthropic | deepseek
LLM_PROVIDER=fake
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
FAKE_PROVIDER_MODE=ok
RECENT_CONTEXT_MESSAGES=12

# Stage 2A Fake TTS. This generates a deterministic test tone, not natural speech.
TTS_PROVIDER=fake
TTS_FAKE_MODE=ok
TTS_MAX_TEXT_CHARS=1000
TTS_DEFAULT_VOICE=fake-default
TTS_DEFAULT_SPEED=1.0

# Stage 2B Fake ASR foundation. This returns deterministic text and does not recognize real speech.
ASR_PROVIDER=fake
ASR_MAX_UPLOAD_BYTES=10485760
ASR_MAX_DURATION_MS=30000
ASR_MIN_DURATION_MS=300
ASR_DEFAULT_LANGUAGE=zh
FAKE_ASR_MODE=ok
FAKE_ASR_TEXT=这是 Fake ASR 测试转写。
FAKE_ASR_DETECTED_LANGUAGE=zh

# Optional Stage 2B-5 real local ASR. Keep ASR_PROVIDER=fake for default tests.
# To enable locally, install backend ASR extras and point the model path to an existing local snapshot.
# Example initial candidate from 2B-4: medium / cuda / float16 / beam=1 / zh.
# ASR_PROVIDER=faster-whisper
# ASR_FASTER_WHISPER_MODEL_PATH=C:\\Users\\<you>\\.cache\\huggingface\\hub\\models--Systran--faster-whisper-medium\\snapshots\\08e178d48790749d25932bbc082711ddcfdfbc4f
ASR_FASTER_WHISPER_MODEL_NAME=medium
ASR_FASTER_WHISPER_MODEL_REVISION=08e178d48790749d25932bbc082711ddcfdfbc4f
ASR_FASTER_WHISPER_DEVICE=cuda
ASR_FASTER_WHISPER_COMPUTE_TYPE=float16
ASR_FASTER_WHISPER_BEAM_SIZE=1
ASR_FASTER_WHISPER_TIMEOUT_SECONDS=30
# Optional Stage 2G-2 real FasterWhisper streaming feasibility. Disabled by default.
# This repeatedly decodes cumulative audio windows and is not final production-grade streaming ASR.
ASR_FASTER_WHISPER_STREAMING_ENABLED=false
ASR_FASTER_WHISPER_STREAMING_WINDOW_MS=3000
ASR_FASTER_WHISPER_STREAMING_STEP_MS=1000
ASR_FASTER_WHISPER_STREAMING_MIN_PARTIAL_CHARS=1
ASR_FASTER_WHISPER_STREAMING_MAX_PARTIALS=8

# DeepSeek Provider is optional. Leave DEEPSEEK_API_KEY empty unless using LLM_PROVIDER=deepseek locally.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING_ENABLED=false
DEEPSEEK_MAX_TOKENS=256
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_RETRIES=0

# Stage 3 long-term memory. Retrieval defaults to deterministic local relevance.
MEMORY_CONTEXT_ENABLED=true
MEMORY_CONTEXT_LIMIT=8
MEMORY_RETRIEVAL_MODE=relevance
MEMORY_RETRIEVAL_FALLBACK_LIMIT=3
MEMORY_CANDIDATES_ENABLED=true
MEMORY_CANDIDATE_PROVIDER=heuristic

# Stage 3F memory embedding retrieval is opt-in.
# Set MEMORY_RETRIEVAL_MODE=embedding and MEMORY_EMBEDDING_ENABLED=true to use embedding retrieval.
# The fake provider is deterministic and intended for local tests/smoke only.
MEMORY_EMBEDDING_ENABLED=false
MEMORY_EMBEDDING_PROVIDER=fake
MEMORY_EMBEDDING_MODEL=fake-memory-embedding-v1
MEMORY_EMBEDDING_MIN_SCORE=0.35

# Vite development proxy only. Do not put API keys or secrets in VITE_* variables.
BACKEND_PROXY_TARGET=http://127.0.0.1:8000

# Only required when LLM_PROVIDER=anthropic.
# Never put a real API key in source control.
ANTHROPIC_API_KEY=
